# ACIS Containerized Infrastructure Environment Template
# Copy this file to .env.docker or .env (which is untracked and excluded in .gitignore)

# Ingress Ports published to host by Caddy reverse proxy
ACIS_HTTP_PORT=8080
ACIS_HTTPS_PORT=8443

# Environment Mode (staging enables local testing with mandatory PostgreSQL & security constraints)
APP_ENV=staging

# Isolated PostgreSQL 18 Database credentials (legacy database identifier preserved to maintain existing volume state)
POSTGRES_DB=acis_phase4a_db
POSTGRES_USER=acis_user
POSTGRES_PASSWORD=acis_secure_password_phase4a

# Application Security Keys (Replace with cryptographically random keys in production)
AUTH_JWT_SIGNING_KEY=qT2IzkWOfnnW2ET9MuuvKlJsPg2AutyfYdN5MGlgOjVC-SYurirMyPBWV67aM5uA
AUTH_EMAIL_LOOKUP_KEY=tncAP0duhWBxQrUBjETSZcYFDq4hNwzJHU4HxSC8aZ4e-mRmibdDbuw7g0BLvmRB
AUTH_COOKIE_SECURE=true
DATA_ENCRYPTION_KEYS={"k1": "ThaUngd25F+xKzpGGO69WmlnRGdT7Wbm5wB7Hf5x1uM="}
DATA_ENCRYPTION_ACTIVE_KEY_ID=k1

# OpenRouter LLM API Key (Optional: leave empty to run backend in mock agent mode)
OPENROUTER_API_KEY=

# Allowed CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","https://localhost:8443","https://127.0.0.1:8443"]
