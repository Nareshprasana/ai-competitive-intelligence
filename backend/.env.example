# ACIS environment configuration (Phase 0 + Phase 1)
# Copy this file to .env and adjust values. Never commit .env with real secrets.

# Application
APP_NAME=ai-competitive-intelligence
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# API
API_V1_STR=/api/v1
# Restricted CORS (comma-separated origins). Default allows only localhost dev.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
SECRET_CHANGE_ME=dev-secret-do-not-use-in-production
MAX_REQUEST_SIZE_MB=4

# LLM provider (OpenRouter-compatible). No calls are made in Phase 1.
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-chat
# Provide your key only when you are ready to consume LLM credits.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT_SECONDS=30

# Database (PostgreSQL + pgvector). Left blank -> database-backed features
# degrade gracefully and health reports database as unavailable.
DATABASE_URL=
DATABASE_TEST_URL=

# Organization / tenant isolation (preparation for future auth/RBAC)
DEFAULT_ORGANIZATION_ID=org-dev