# ACIS environment configuration (Phase 0 + Phase 1)
# Copy this file to .env and adjust values. Never commit .env with real secrets.

# Application
APP_NAME=ai-competitive-intelligence
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# API
API_V1_STR=/api/v1
# Restricted CORS (comma-separated origins). Default allows only localhost dev.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security. Generate unique secrets outside Git; never reuse these placeholders.
MAX_REQUEST_SIZE_MB=4
AUTH_JWT_SIGNING_KEY=
AUTH_EMAIL_LOOKUP_KEY=
# For each value above, generate a unique secret with:
# python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_ACCESS_TOKEN_MINUTES=10
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false
# JSON object mapping key IDs to base64-encoded 32-byte AES-256 keys.
# Generate a key with Python: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_ACTIVE_KEY_ID=
API_RATE_LIMIT_REQUESTS=120
AUTH_RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# LLM provider (OpenRouter-compatible). No calls are made in Phase 1.
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-chat
# Provide your key only when you are ready to consume LLM credits.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT_SECONDS=30

# Database (PostgreSQL + pgvector). Authentication, protected API routes,
# audit logging, rate limits, persistence, and checkpointing require PostgreSQL.
# Leaving it blank is supported only for local direct-service/unit tests.
# Example: postgresql+asyncpg://acis_app:acis_dev_password@127.0.0.1:5432/acis_db
DATABASE_URL=
DATABASE_TEST_URL=

# LangGraph checkpoint database (separate from business records when desired).
# Defaults to DATABASE_URL when not set.
LANGGRAPH_CHECKPOINT_DATABASE_URL=

# Development fallback used only by direct service tests without PostgreSQL.
# API requests always derive the organization from validated membership.
DEFAULT_ORGANIZATION_ID=org-dev

# Search provider (company research agent, Phase 2A)
# Use 'mock' for deterministic offline results (no network, no credits).
# Use 'duckduckgo' for live DuckDuckGo HTML search (free, no API key).
SEARCH_PROVIDER=mock
SEARCH_MAX_QUERIES=8
SEARCH_MAX_PAGES=10
DUCKDUCKGO_BASE_URL=https://html.duckduckgo.com/html/